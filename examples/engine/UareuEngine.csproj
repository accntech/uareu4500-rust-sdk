<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SourceAFIS" Version="3.14.0" />
    <PackageReference Include="System.Formats.Cbor" Version="10.0.0" />
    <!-- Raw-pixel constructor only: do not compile, copy, or use the optional
         encoded-image decoder or its build targets/runtime assets. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
</Project>
